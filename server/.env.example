# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- MongoDB ----
# Local:  mongodb://127.0.0.1:27017/aapna_times
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aapna_times
MONGO_URI=mongodb://127.0.0.1:27017/aapna_times

# ---- Auth ----
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- Optional: external news (https://newsapi.org -> free key) ----
NEWSAPI_KEY=

# ---- Seed admin (used by npm run seed) ----
ADMIN_EMAIL=admin@aapnatimes.com
ADMIN_PASSWORD=Admin@12345

# ---- Public website address (used in sitemap, RSS and link previews) ----
# Local single-server mode: http://localhost:5000   |   Production: https://www.yourdomain.com
PUBLIC_URL=http://localhost:5173

# ---- Optional rate limits (requests per 15 minutes per IP) ----
RATE_LIMIT=600
AUTH_RATE_LIMIT=20
